{
  "name": "marktext-clone",
  "version": "0.1.0",
  "private": true,
  "description": "仿 MarkText 的免费 Markdown 编辑器（全中文菜单 / 导出 HTML·PDF·DOCX）",
  "main": "./out/main/index.js",
  "author": "中色丝路资源科技（北京）有限公司",
  "license": "MIT",
  "engines": {
    "node": ">=22.11.0"
  },
  "scripts": {
    "postinstall": "node scripts/check-env.cjs",
    "dev": "electron-vite dev",
    "preview": "electron-vite preview",
    "build": "npm run typecheck && electron-vite build",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.json",
    "test": "node scripts/run-node.cjs node_modules/vitest/vitest.mjs run",
    "test:watch": "node scripts/run-node.cjs node_modules/vitest/vitest.mjs",
    "icon": "node scripts/make-icon.cjs",
    "dist:win": "npm run icon && npm run build && node scripts/run-node.cjs node_modules/electron-builder/out/cli/cli.js --win --config electron-builder.yml"
  },
  "dependencies": {
    "docx": "^9.7.2",
    "iconv-lite": "^0.7.3",
    "jschardet": "^3.1.4",
    "katex": "^0.18.9",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "rehype-stringify": "^10.0.1",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.18.0",
    "@codemirror/commands": "^6.8.0",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.11.0",
    "@codemirror/language-data": "^6.5.0",
    "@codemirror/search": "^6.5.0",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.13",
    "@lezer/highlight": "^1.2.4",
    "@types/hast": "^3.0.5",
    "@types/node": "^26.6.3",
    "@vitejs/plugin-vue": "^6.0.9",
    "codemirror": "^6.0.2",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "highlight.js": "^11.12.0",
    "jsdom": "^27.0.1",
    "mermaid": "^12.0.0",
    "pinia": "^4.0.3",
    "typescript": "~5.9.3",
    "vite": "^7.3.6",
    "vitest": "^5.0.2",
    "vue": "^3.5.43",
    "vue-tsc": "^3.3.11"
  }
}
